{
  "name": "taskade",
  "version": "0.1.0",
  "description": "The future of collaborative productivity - on a journey to 100K GitHub stars",
  "main": "src/index.ts",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx,.js,.jsx",
    "lint:fix": "eslint src --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write src/**/*.{ts,tsx,js,jsx,css,md}",
    "type-check": "tsc --noEmit",
    "prepare": "husky install",
    "semantic-release": "semantic-release",
    "docker:build": "docker build -t taskade .",
    "docker:dev": "docker-compose up -d",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jonesiiiedwin0-ops/Taskade.git"
  },
  "keywords": [
    "productivity",
    "collaboration",
    "task-management",
    "real-time",
    "opensource",
    "react",
    "typescript",
    "nodejs"
  ],
  "author": "Taskade Team <hello@taskade.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jonesiiiedwin0-ops/Taskade/issues"
  },
  "homepage": "https://github.com/jonesiiiedwin0-ops/Taskade#readme",
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "typescript": "^5.0.0",
    "vite": "^4.3.0",
    "@vitejs/plugin-react": "^4.0.0"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "eslint": "^8.40.0",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^2.8.0",
    "husky": "^8.0.3",
    "jest": "^29.5.0",
    "@playwright/test": "^1.34.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}